    "year_cols = [c for c in df.columns if c.startswith(\"Tons_\")]\n",
    "\n",
    "# Melt while keeping all other columns\n",
    "df_long = df.melt(\n",
    "    id_vars=[c for c in df.columns if c not in year_cols],\n",
    "    value_vars=year_cols,\n",
    "    var_name='Year',\n",
    "    value_name='Tons'\n",
    ")\n",
    "\n",
    "# Extract numeric year from 'kg_2018' → 2018\n",
    "df_long['Year'] = df_long['Year'].str.extract(r'(\\d{4})').astype(int)\n",
    "display(df_long)"
   ]
