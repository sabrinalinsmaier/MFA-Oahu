   "source": [
    "# material specific shares\n",
    "# Initialize an empty DataFrame to store the aggregate data\n",
    "aggregate_data = pd.DataFrame()\n",
    "\n",
    "# Loop over the years and append data to the aggregate DataFrame\n",
    "for year in years:\n",
    "    comparison_df = results[year]  # Get the DataFrame for each year\n",
    "    comparison_df['Year'] = year  # Add a 'Year' column to track the year\n",
    "\n",
    "    # Append the data to the aggregate_data DataFrame\n",
    "    aggregate_data = pd.concat([aggregate_data, comparison_df])"
   ]
  },
