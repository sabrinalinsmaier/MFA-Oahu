   "source": [
    "#### 3) Comparison and Creation of a share dataframe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "e174e1f4-fdae-4311-b1ab-ee1b2f39e9b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# loop through all years\n",
    "years = range(2013, 2024)\n",
    "results = {}  #store results in a dictionary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "2416e19a-df92-444b-bc04-05467eae9836",
   "metadata": {},
   "outputs": [],
   "source": [
    "for year in years:\n",
    "    # Read the data for the current year\n",
    "    Oahu = pd.read_excel(f\"Oahu_MFA{year}.xlsx\")\n",
    "    Hawaii = pd.read_excel(f\"Hawaii_MFA{year}.xlsx\")\n",
    "\n",
    "    pivot_Oahu = Oahu.pivot_table(\n",
    "        index=\"Material\", \n",
    "        columns=[\"Source\", \"Target\"], \n",
    "        values=f\"Tons\", \n",
    "        aggfunc=\"sum\")\n",
    "    pivot_Hawaii = Hawaii.pivot_table(\n",
    "        index=\"Material\", \n",
    "        columns=[\"Source\", \"Target\"], \n",
    "        values=f\"Tons\", \n",
    "        aggfunc=\"sum\")\n",
    "\n",
    "    # Flatten the columns to avoid MultiIndex\n",
    "    pivot_Oahu.columns = [f\"{source}_{target}\" for source, target in pivot_Oahu.columns]\n",
    "    \n",
    "    pivot_Hawaii.columns = [f\"{source}_{target}\" for source, target in pivot_Hawaii.columns]\n",
    "\n",
    "    # Combine the data into a comparison DataFrame\n",
    "    comparison_df = pd.DataFrame({\n",
    "        'Material': pivot_Oahu.index,\n",
    "        'Exports_Oahu': pivot_Oahu['NAS_Exports'],\n",
    "        'Imports_Oahu': pivot_Oahu['Imports_DMI'],\n",
    "        'Exports_Hawaii': pivot_Hawaii['NAS_Exports'],\n",
    "        'Imports_Hawaii': pivot_Hawaii['Imports_DMI']\n",
    "    })\n",
    "\n",
    "    # Calculate shares\n",
    "    comparison_df['Export_Oahu_Share'] = comparison_df['Exports_Oahu'] / comparison_df['Exports_Hawaii']\n",
    "    comparison_df['Import_Oahu_Share'] = comparison_df['Imports_Oahu'] / comparison_df['Imports_Hawaii']\n",
    "\n",
    "    # Store the DataFrame for this year in the results dictionary\n",
    "    results[year] = comparison_df"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ce25792d-b74c-49a1-8e97-450b403f58f1",
   "metadata": {},
   "source": [
    "### Application of shares"
   ]
  },
  {
   "cell_type": "code",
