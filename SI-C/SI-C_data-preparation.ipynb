   "source": [
    "# change the format from wide to long\n",
    "# Automatically detect year columns (those starting with 'tons_')\n",
    "year_cols = [c for c in df_final.columns if c.startswith(\"tons_\")]\n",
    "\n",
    "# Melt while keeping all other columns\n",
    "df_long = df_final.melt(\n",
    "    id_vars=[c for c in df_final.columns if c not in year_cols],\n",
    "    value_vars=year_cols,\n",
    "    var_name='Year',\n",
    "    value_name='Tons'\n",
    ")\n",
    "\n",
    "# Extract numeric year from 'kg_2018' → 2018\n",
    "df_long['Year'] = df_long['Year'].str.extract(r'(\\d{4})').astype(int)\n",
    "\n",
    "df_final = df_long.copy()\n",
    "df_final = df_final.rename(columns={\"Source\": \"Origin\", \"Target\": \"Destination\"})\n",
    "df_final['Source'] = np.where(df_final[\"Origin\"].str.contains(\"Imports\", case=False, na=False), \"Imports\", \"NAS\")\n",
    "df_final['Target'] = np.where(df_final[\"Destination\"].str.contains(\"Exports\", case=False, na=False), \"Exports\", \"DMI\")\n",
    "\n",
    "# to follow the same column structure, trade_type is deleted from the df\n",
    "df_final = df_final.drop(columns=['dist_band'])"
   ]
