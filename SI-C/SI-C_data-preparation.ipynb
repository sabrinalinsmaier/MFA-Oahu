   "source": [
    "### Backcasting of export data  \n",
    "For exports, the application of an export share does not work, because of higher exports from Oahu to the other Hawaiian Islands than exports from total Hawaii to other world regions. We therefore apply a backcasting method by reverting Holt's forecasting method."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 89,
   "id": "3c95d194-ecaf-4966-9ab3-998f2512143f",
   "metadata": {},
   "outputs": [],
   "source": [
    "exp = pd.read_table(\"exports.txt\", sep =\";\").reset_index()\n",
    "exp = exp.rename(columns={'Material' : 'Year', 'index': 't'})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 91,
   "id": "a04f2957-1e2d-496e-b074-8c1ebec9d642",
   "metadata": {},
   "outputs": [],
   "source": [
    "# define backcasting period\n",
    "start_backcast = 10\n",
    "end_backcast = 26\n",
    "\n",
    "n_backcast = end_backcast - start_backcast\n",
    "#print(n_backcast)  # should be 16\n",
    "years_backcast = np.arange(end_backcast - n_backcast +1, end_backcast+1)\n",
    "#print(years_backcast)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 93,
   "id": "e8ac8509-1da9-4ffe-bf26-f4d7d898a688",
   "metadata": {},
   "outputs": [],
   "source": [
    "#holt forecasting\n",
    "def holt_double_exponential(y, alpha, beta):\n",
    "    \"\"\"\n",
    "    Holt's Double Exponential Smoothing\n",
    "    \n",
    "    Parameters:\n",
    "        y (array-like): Zeitreihe\n",
    "        alpha (float): Level smoothing parameter\n",
    "        beta (float): Trend smoothing parameter\n",
    "        \n",
    "    Returns:\n",
    "        fitted_values (np.array)\n",
    "        level (np.array)\n",
    "        trend (np.array)\n",
    "    \"\"\"\n",
    "    \n",
    "    y = np.array(y)\n",
    "    n = len(y)\n",
    "    \n",
    "    level = np.zeros(n)\n",
    "    trend = np.zeros(n)\n",
    "    fitted = np.zeros(n)\n",
    "    \n",
    "    # Initialization\n",
    "    level[0] = y[0]\n",
    "    trend[0] = (y[-1] - y[0]) / (len(y) - 1)\n",
    "    #trend[0] = np.mean(np.diff(y[:3])) #more robust\n",
    "    # trend[0] = y[1] - y[0]\n",
    "    fitted[0] = y[0]\n",
    "    \n",
    "    for t in range(1, n):\n",
    "        fitted[t] = level[t-1] + trend[t-1]\n",
    "        \n",
    "        level[t] = alpha * y[t] + (1 - alpha) * (level[t-1] + trend[t-1])\n",
    "        trend[t] = beta * (level[t] - level[t-1]) + (1 - beta) * trend[t-1]\n",
    "    \n",
    "    return fitted, level, trend"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 95,
   "id": "91ba2658-6f95-44cc-b4ba-7ccbc8af93ba",
   "metadata": {},
   "outputs": [],
   "source": [
    "#tracking signal\n",
    "def tracking_signal(y, fitted):\n",
    "    errors = y - fitted\n",
    "    cfe = np.sum(errors)\n",
    "    mad = np.mean(np.abs(errors))\n",
    "    \n",
    "    if mad == 0:\n",
    "        return 0\n",
    "    \n",
    "    return cfe / mad"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 97,
   "id": "a8a0848f-06da-4347-b5d6-805f0cc74b6e",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Theil's inequality coefficient\n",
    "def theils_u(y, fitted):\n",
    "    y = np.array(y)\n",
    "    fitted = np.array(fitted)\n",
    "    \n",
    "    numerator = np.sqrt(np.mean((y - fitted)**2))\n",
    "    denominator = (\n",
    "        np.sqrt(np.mean(y**2)) + \n",
    "        np.sqrt(np.mean(fitted**2))\n",
    "    )\n",
    "    \n",
    "    if denominator == 0:\n",
    "        return np.inf\n",
    "    \n",
    "    return numerator / denominator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 99,
   "id": "ee8617df-fdf6-4080-b8c9-632b879803df",
   "metadata": {},
   "outputs": [],
   "source": [
    "def optimize_holt(y, alphas=None, betas=None):\n",
    "    \n",
    "    if alphas is None:\n",
    "        alphas = np.linspace(0.01, 0.99, 30)\n",
    "    if betas is None:\n",
    "        betas = np.linspace(0.01, 0.99, 30)\n",
    "    \n",
    "    best_score = np.inf\n",
    "    best_params = None\n",
    "    \n",
    "    for alpha in alphas:\n",
    "        for beta in betas:\n",
    "            \n",
    "            fitted, _, _ = holt_double_exponential(y, alpha, beta)\n",
    "            \n",
    "            ts = abs(tracking_signal(y, fitted))  # keep structural errors low\n",
    "            u = theils_u(y, fitted)\n",
    "            \n",
    "            # combined goal, weighted\n",
    "            score = u + ts * 0.1\n",
    "            \n",
    "            if score < best_score:\n",
    "                best_score = score\n",
    "                best_params = (alpha, beta)\n",
    "    \n",
    "    return best_params"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 101,
   "id": "cf0775bc-239d-467a-b2f0-eece30ebfec8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def holt_forecast(y, alpha, beta, h):\n",
    "    \"\"\"\n",
    "    Holt + h-step Forecast\n",
    "    \"\"\"\n",
    "    \n",
    "    fitted, level, trend = holt_double_exponential(y, alpha, beta)\n",
    "    \n",
    "    forecasts = np.array([\n",
    "        level[-1] + (i+1) * trend[-1] for i in range(h)\n",
    "    ])\n",
    "    \n",
    "    return fitted, forecasts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 103,
   "id": "a03fbcd6-09eb-4f59-ad0b-2547ebf41a56",
   "metadata": {},
   "outputs": [],
   "source": [
    "results_backcast = {}\n",
    "\n",
    "for col in exp.columns:\n",
    "    if col != \"t\":\n",
    "        \n",
    "        y = exp[col].values\n",
    "        \n",
    "        # optimize parameters alpha and beta\n",
    "        alpha_opt, beta_opt = optimize_holt(y)\n",
    "        \n",
    "        # Backcast \n",
    "        backcast_values = holt_forecast(\n",
    "            y, alpha_opt, beta_opt, n_backcast\n",
    "        )\n",
    "        \n",
    "        results_backcast[col] = backcast_values"
   ]
  },
