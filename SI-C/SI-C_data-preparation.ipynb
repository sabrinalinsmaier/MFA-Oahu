   "source": [
    "part1 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_origst'] == \"Hawaii\") & (Hawaii['dms_destst'] != \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_origst': 'Source', 'dms_destst': 'Target'})\n",
    "part2 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_origst'] == \"Hawaii\") & (Hawaii['dms_destst'] != \"Hawaii\") & (Hawaii['fr_dest'] != -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_origst': 'Source', 'dms_destst': 'Target'})\n",
    "part3 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_origst'] == \"Hawaii\") & (Hawaii['dms_destst'] == \"Hawaii\") & (Hawaii['fr_dest'] != -1)].drop(columns=['fr_orig', 'dms_origst']).rename(columns={'dms_destst': 'Source', 'fr_dest': 'Target'})\n",
    "part4 = Hawaii[(Hawaii['fr_orig'] != -1) & (Hawaii['dms_origst'] == \"Hawaii\") & (Hawaii['dms_destst'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['dms_destst', 'fr_dest']).rename(columns={'fr_orig': 'Source', 'dms_origst': 'Target'})\n",
    "part5 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_origst'] != \"Hawaii\") & (Hawaii['dms_destst'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_origst': 'Source', 'dms_destst': 'Target'})\n",
    "part6 = Hawaii[(Hawaii['fr_orig'] != -1) & (Hawaii['dms_origst'] != \"Hawaii\") & (Hawaii['dms_destst'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_origst': 'Source', 'dms_destst': 'Target'})\n",
    "# Combine all parts\n",
    "df_final = pd.concat([part1, part2, part3, part4, part5, part6], ignore_index=True)\n",
    "df_final.head()"
   ]
  },
