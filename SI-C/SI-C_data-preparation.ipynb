   "source": [
    "for year in years:\n",
    "    df = pd.read_excel(\"Hawaii_MFA1997-2012.xlsx\")\n",
    "    # Create the column name corresponding to the current year\n",
    "    target_column = f\"tons_{year}\"\n",
    "    # Drop any columns that start with 'tons_' except the target column\n",
    "    columns_to_drop = [col for col in df.columns if col.startswith(\"tons_\") and col != target_column]\n",
    "    \n",
    "    # Drop the columns\n",
    "    df.drop(columns=columns_to_drop, inplace=True)\n",
    "\n",
    "    # merge dataframe with parameters\n",
    "    merged_df = pd.merge(df, parameters, on='Material')\n",
    "    \n",
    "    # Multiplying the columns for new adjusted values\n",
    "    # Define conditions\n",
    "    conditions = [\n",
    "        merged_df[\"Source\"].str.contains(\"Import\"),\n",
    "        # (merged_df[\"Source\"].str.contains(\"NAS\")) & (merged_df[\"Material\"] == \"waste\"),\n",
    "        merged_df[\"Source\"].str.contains(\"NAS\")\n",
    "    ]\n",
    "    \n",
    "    # Define corresponding results\n",
    "    choices = [\n",
    "        merged_df[f\"tons_{year}\"] * merged_df[\"Import_Oahu_Share\"],\n",
    "        # merged_df[f\"tons_{year}\"] * merged_df[\"Export_Oahu_Share\"],\n",
