   "source": [
    "FAF5_sctg2 = pd.read_excel(\"[insert_your_path_here]/SI-B.xlsx\", sheet_name = \"FAF5\")\n",
    "desc_map = FAF5_sctg2.set_index(\"Code\")[\"Commodity Description\"]\n",
    "mat_map = FAF5_sctg2.set_index(\"Code\")[\"Material\"]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9fa0270c-777e-4602-ba92-38678410e256",
   "metadata": {},
   "source": [
    "Download link to FAF5.6.1: https://www.bts.gov/faf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "a550349a-8585-4308-b5a1-e8daa0b4a0c4",
   "metadata": {},
   "outputs": [],
   "source": [
    "Oahu = pd.read_csv(\"[insert_your_path_here]\FAF5.6.1_2018-2023.csv\")\n",
    "# Keep only the first 15 columns (removing columns 16-30) (reduce the size of df)\n",
    "Oahu = Oahu.iloc[:, :16]\n",
    "df = Oahu\n",
    "# Filter for rows where dms_orig or dms_dest is 151 (Honolulu)\n",
    "origin151 = df[df['dms_orig'] == 151]\n",
    "dest151 = df[df['dms_dest'] == 151]\n",
    "\n",
    "# Remove rows where dms_orig == dms_dest (both 151), is only deleted in one of them, so there are no duplicates\n",
    "dest151 = dest151[dest151['dms_orig'] != 151]\n",
    "\n",
    "# Combine filtered data\n",
    "Oahu = pd.concat([origin151, dest151], ignore_index=True)\n",
    "# Python reads some columns not as numbers\n",
    "Oahu['dms_orig'] = pd.to_numeric(Oahu['dms_orig'], errors='coerce')\n",
    "Oahu['dms_dest'] = pd.to_numeric(Oahu['dms_dest'], errors='coerce')\n",
    "Oahu['fr_dest'] = Oahu['fr_dest'].fillna(-1).astype(int)  # Replace NaN with -1, then convert to int\n",
    "Oahu['fr_orig'] = Oahu['fr_orig'].fillna(-1).astype(int)\n",
    "\n",
    "# Replace numeric locations with names, first dms_orig\n",
    "def map_location(value):\n",
    "    if value == -1:  # Skip processing if value is -1\n",
    "        return -1\n",
    "    if value == 151:\n",
    "        return \"Honolulu\"\n",
    "    elif value == 159:\n",
    "        return \"Imports from Rest of HI\"\n",
    "    elif 801 <= value <= 808:\n",
    "        return {\n",
    "            801: \"Imports from Canada\",\n",
    "            802: \"Imports from Mexico\",\n",
    "            803: \"Imports from Rest of Americas\",\n",
    "            804: \"Imports from Europe\",\n",
    "            805: \"Imports from Africa\",\n",
    "            806: \"Imports from SW & Central Asia\",\n",
    "            807: \"Imports from Eastern Asia\",\n",
    "            808: \"Imports from SE Asia & Oceania\"\n",
    "        }.get(value, value)\n",
    "    else:\n",
    "        return \"Imports from US mainland\"\n",
    "\n",
    "Oahu['dms_orig'] = Oahu['dms_orig'].apply(map_location)\n",
    "Oahu['fr_orig'] = Oahu['fr_orig'].apply(map_location)\n",
    "\n",
    "def map_location(value):\n",
    "    if value == -1:  # Skip processing if value is -1\n",
    "        return -1\n",
    "    if value == 151:\n",
    "        return \"Honolulu\"\n",
    "    elif value == 159:\n",
    "        return \"Exports to Rest of HI\"\n",
    "    elif 801 <= value <= 808:\n",
    "        return {\n",
    "            801: \"Exports to Canada\",\n",
    "            802: \"Exports to Mexico\",\n",
    "            803: \"Exports to Rest of Americas\",\n",
    "            804: \"Exports to Europe\",\n",
    "            805: \"Exports to Africa\",\n",
    "            806: \"Exports to SW & Central Asia\",\n",
    "            807: \"Exports to Eastern Asia\",\n",
    "            808: \"Exports to SE Asia & Oceania\"\n",
    "        }.get(value, value)\n",
    "    else:\n",
    "        return \"Exports to US mainland\"\n",
    "\n",
    "Oahu['dms_dest'] = Oahu['dms_dest'].apply(map_location)\n",
    "Oahu['fr_dest'] = Oahu['fr_dest'].apply(map_location)\n",
    "\n",
    "part1 = Oahu[(Oahu['fr_orig'] == -1) & (Oahu['dms_orig'] == \"Honolulu\")  & (Oahu['dms_dest'] != \"Honolulu\") & (Oahu['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "part2 = Oahu[(Oahu['fr_orig'] == -1) & (Oahu['dms_orig'] == \"Honolulu\")  & (Oahu['dms_dest'] != \"Honolulu\") & (Oahu['fr_dest'] != -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "part3 = Oahu[(Oahu['fr_orig'] == -1) & (Oahu['dms_orig'] == \"Honolulu\")  & (Oahu['dms_dest'] == \"Honolulu\") & (Oahu['fr_dest'] != -1)].drop(columns=['fr_orig', 'dms_orig']).rename(columns={'dms_dest': 'Source', 'fr_dest': 'Target'})\n",
    "part4 = Oahu[(Oahu['fr_orig'] != -1) & (Oahu['dms_orig'] != \"Honolulu\")  & (Oahu['dms_dest'] == \"Honolulu\") & (Oahu['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "part5 = Oahu[(Oahu['fr_orig'] == -1) & (Oahu['dms_orig'] != \"Honolulu\")  & (Oahu['dms_dest'] == \"Honolulu\") & (Oahu['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "part6 = Oahu[(Oahu['fr_orig'] != -1) & (Oahu['dms_orig'] == \"Honolulu\")  & (Oahu['dms_dest'] == \"Honolulu\") & (Oahu['fr_dest'] == -1)].drop(columns=['dms_dest', 'fr_dest']).rename(columns={'fr_orig': 'Source', 'dms_orig': 'Target'})\n",
    "\n",
    "# Combine all parts\n",
    "df_final = pd.concat([part1, part2, part3, part4, part5, part6], ignore_index=True)\n",
    "df_final.head()\n",
