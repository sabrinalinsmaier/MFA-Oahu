   "source": [
    "df = Hawaii\n",
    "# Filter for rows where dms_orig or dms_dest is 15 (Hawaii)\n",
    "origin15 = df[df['dms_origst'] == 15]\n",
    "dest15 = df[df['dms_destst'] == 15]\n",
    "\n",
    "# Remove rows where dms_orig == dms_dest (both 15), is only deleted in one of them, so there are no duplicates\n",
    "dest15 = dest15[dest15['dms_origst'] != 15]\n",
    "\n",
    "# Combine filtered data\n",
    "Hawaii = pd.concat([origin15, dest15], ignore_index=True) \n",
    "Hawaii['dms_origst'] = pd.to_numeric(Hawaii['dms_origst'], errors='coerce')\n",
    "Hawaii['dms_destst'] = pd.to_numeric(Hawaii['dms_destst'], errors='coerce')\n",
    "Hawaii['fr_dest'] = Hawaii['fr_dest'].fillna(-1).astype(int)  # Replace NaN with -1, then convert to int\n",
    "Hawaii['fr_orig'] = Hawaii['fr_orig'].fillna(-1).astype(int)\n",
    "\n",
    "Hawaii.head()"
   ]
  },
