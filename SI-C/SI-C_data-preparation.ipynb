   "source": [
    "#read recycling data\n",
    "path = r\"[insert_your_path_here]/2021_and_previous_years_recycling_data_breakdown.xlsx\"\n",
    "r = pd.read_excel(path)\n",
    "years = (1997,2002,2007,2012,2017,2022)\n",
    "# Read the first sheet to start the DataFrame\n",
    "final_data = pd.read_excel(path, sheet_name=f\"{years[0]}\")\n",
    "final_data = final_data.rename(columns={'Material Type': 'Material', 'category': 'Category', 'amount in tons': f'Tons_{years[0]}'})\n",
    "\n",
    "# Loop through the remaining years to pull 'amount in tons' columns from each sheet\n",
    "for year in years[1:]:\n",
    "    gw = pd.read_excel(path, sheet_name=f\"{year}\")\n",
    "    gw = gw.rename(columns={'Material Type': 'Material', 'category': 'Category','amount in tons': f'Tons_{year}'})\n",
    "    \n",
    "    # Merge on Material and Category columns to keep the structure consistent\n",
    "    final_data = pd.merge(final_data, gw[['Material', 'Category', f'Tons_{year}']], on=['Material', 'Category'], how='outer')\n",
    "\n",
    "# Display the final DataFrame\n",
    "display(final_data)"
   ]
  },
