   "source": [
    "#### 2) Available Data for Hawaii and Approximation of Oahu   \n",
    "There is no data available for Oahu for years prior to 2013. Therefore, available statelevel data is used. To estimate the share of Oahu, we compare Hawaii-level data with Oahu-level data for the overlapping available time period of 2013-2022. As a second step, we calculate shares per sctg2 category and apply them on the historic Hawaii data on 1997-2012."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "59344e90-2b7c-4ff1-ab0f-ac5abcb8100c",
   "metadata": {},
   "source": [
    "##### 2.1) Analysis of Hawaii data  \n",
    "__2013-2017__"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "fc575163-737c-47d0-97c2-6cb16326e466",
   "metadata": {},
   "outputs": [],
   "source": [
    "years = [2013, 2014, 2015, 2016, 2017]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "a55317bb-c7e1-4c49-b707-0e7519cc846d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dictionary for description \n",
    "desc_map = FAF4_sctg2.set_index(\"Code\")[\"Commodity Description\"]\n",
    "mat_map = FAF4_sctg2.set_index(\"Code\")[\"Material\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "7508001f-ef83-4c1f-b2a3-ad00f0334567",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Processed 2013 and saved to Hawaii_MFA2013.xlsx\n",
      "Processed 2014 and saved to Hawaii_MFA2014.xlsx\n",
      "Processed 2015 and saved to Hawaii_MFA2015.xlsx\n",
      "Processed 2016 and saved to Hawaii_MFA2016.xlsx\n",
      "Processed 2017 and saved to Hawaii_MFA2017.xlsx\n"
     ]
    }
   ],
   "source": [
    "for year in years:\n",
    "    file_path = f\"[insert_your_path_here]\FAF4.5.1_State_{year}.csv\"\n",
    "    df = pd.read_csv(file_path)\n",
    "    \n",
    "    # Remove columns 11-13 (0-based index, so it's columns 10-13)\n",
    "    df = df.drop(df.columns[10:13], axis=1)\n",
    "    \n",
    "    df = df.rename(columns={'dms_origst':'dms_orig','dms_destst':'dms_dest'})\n",
    "    \n",
    "    # Filter for rows where dms_orig or dms_dest is 151 (Honolulu)\n",
    "    origin15 = df[df['dms_orig'] == 15]\n",
    "    dest15 = df[(df['dms_dest'] == 15) & (df['dms_orig'] != 15)]\n",
    "    \n",
    "    # Combine the filtered datasets\n",
    "    Hawaii = pd.concat([origin15, dest15], ignore_index=True)\n",
    "    \n",
    "    # Python reads some columns not as numbers\n",
    "    Hawaii['dms_orig'] = pd.to_numeric(Hawaii['dms_orig'], errors='coerce')\n",
    "    Hawaii['dms_dest'] = pd.to_numeric(Hawaii['dms_dest'], errors='coerce')\n",
    "    Hawaii['fr_dest'] = Hawaii['fr_dest'].fillna(-1).astype(int)  # Replace NaN with -1, then convert to int\n",
    "    Hawaii['fr_orig'] = Hawaii['fr_orig'].fillna(-1).astype(int)\n",
    "    \n",
    "    # Mapping function for locations\n",
    "    def map_location(value):\n",
    "        if value == -1:  # Skip processing if value is -1\n",
    "            return -1\n",
    "        if value == 15:\n",
    "            return \"Hawaii\"\n",
    "        elif 801 <= value <= 808:\n",
    "            return {\n",
    "                801: \"Imports from Canada\",\n",
    "                802: \"Imports from Mexico\",\n",
    "                803: \"Imports from Rest of Americas\",\n",
    "                804: \"Imports from Europe\",\n",
    "                805: \"Imports from Africa\",\n",
    "                806: \"Imports from SW & Central Asia\",\n",
    "                807: \"Imports from Eastern Asia\",\n",
    "                808: \"Imports from SE Asia & Oceania\"\n",
    "            }.get(value, value)\n",
    "        else:\n",
    "            return \"Imports from US mainland\"\n",
    "            \n",
    "    Hawaii['dms_orig'] = Hawaii['dms_orig'].apply(map_location)\n",
    "    Hawaii['fr_orig'] = Hawaii['fr_orig'].apply(map_location)\n",
    "    \n",
    "    def map_location(value):\n",
    "        if value == -1:  # Skip processing if value is -1\n",
    "            return -1\n",
    "        if value == 15:\n",
    "            return \"Hawaii\"\n",
    "        elif 801 <= value <= 808:\n",
    "            return {\n",
    "                801: \"Exports to Canada\",\n",
    "                802: \"Exports to Mexico\",\n",
    "                803: \"Exports to Rest of Americas\",\n",
    "                804: \"Exports to Europe\",\n",
    "                805: \"Exports to Africa\",\n",
    "                806: \"Exports to SW & Central Asia\",\n",
    "                807: \"Exports to Eastern Asia\",\n",
    "                808: \"Exports to SE Asia & Oceania\"\n",
    "            }.get(value, value)\n",
    "        else:\n",
    "            return \"Exports to US mainland\"\n",
    "            \n",
    "    Hawaii['dms_dest'] = Hawaii['dms_dest'].apply(map_location)\n",
    "    Hawaii['fr_dest'] = Hawaii['fr_dest'].apply(map_location)\n",
    "    \n",
    "    # Define filtering options\n",
    "    part1 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_orig'] == \"Hawaii\") & (Hawaii['dms_dest'] != \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "    part2 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_orig'] == \"Hawaii\") & (Hawaii['dms_dest'] != \"Hawaii\") & (Hawaii['fr_dest'] != -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "    part3 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_orig'] == \"Hawaii\") & (Hawaii['dms_dest'] == \"Hawaii\") & (Hawaii['fr_dest'] != -1)].drop(columns=['fr_orig', 'dms_orig']).rename(columns={'dms_dest': 'Source', 'fr_dest': 'Target'})\n",
    "    part4 = Hawaii[(Hawaii['fr_orig'] != -1) & (Hawaii['dms_orig'] == \"Hawaii\") & (Hawaii['dms_dest'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['dms_dest', 'fr_dest']).rename(columns={'fr_orig': 'Source', 'dms_orig': 'Target'})\n",
    "    part5 = Hawaii[(Hawaii['fr_orig'] == -1) & (Hawaii['dms_orig'] != \"Hawaii\") & (Hawaii['dms_dest'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "    part6 = Hawaii[(Hawaii['fr_orig'] != -1) & (Hawaii['dms_orig'] != \"Hawaii\") & (Hawaii['dms_dest'] == \"Hawaii\") & (Hawaii['fr_dest'] == -1)].drop(columns=['fr_orig', 'fr_dest']).rename(columns={'dms_orig': 'Source', 'dms_dest': 'Target'})\n",
    "    \n",
    "    # Combine all parts\n",
    "    df_final = pd.concat([part1, part2, part3, part4, part5, part6], ignore_index=True)\n",
    "    \n",
    "    # Rename columns\n",
    "    df_final.columns = [\"Source\", \"Target\", \"fr_inmode\", \"dms_mode\", \"fr_outmode\", \"sctg2\", \"trade_type\", \"Tons\"]\n",
    "    \n",
    "    df_final[\"Commodity Description\"] = df_final[\"sctg2\"].map(desc_map)\n",
    "    df_final[\"Material\"] = df_final[\"sctg2\"].map(mat_map)\n",
    "\n",
    "    #here, Origin and Destination as well as Source and Target need to be adapted\n",
    "    df_final = df_final.rename(columns={\"Source\": \"Origin\", \"Target\": \"Destination\"})\n",
    "    df_final['Source'] = np.where(df_final[\"Origin\"].str.contains(\"Imports\", case=False, na=False), \"Imports\", \"NAS\")\n",
    "    df_final['Target'] = np.where(df_final[\"Destination\"].str.contains(\"Exports\", case=False, na=False), \"Exports\", \"DMI\")\n",
    "    df_final[\"Source_Index\"] = np.where(df_final[\"Source\"].str.contains(\"Imports\", case=False, na=False), 0, 5) # 0 Imports, 5 NAS > Exports\n",
    "    df_final[\"Target_Index\"] = np.where(df_final[\"Target\"].str.contains(\"Exports\", case=False, na=False), 11, 1) # 11 Exports, 1 DMI\n",
    "    df_final[\"Flow\"] = \"F\" + df_final[\"Source_Index\"].astype(str) + \"_\" + df_final[\"Target_Index\"].astype(str)\n",
    "    \n",
    "    # Save results\n",
    "    output_file = f\"Hawaii_MFA{year}.xlsx\"\n",
    "    df_final.to_excel(output_file, index=False)\n",
    "    print(f\"Processed {year} and saved to {output_file}\")"
   ]
  },
